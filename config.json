{
  "version": 1,
  "nombre": "LeyClara",

  "corpus": {
    "db": "corpus/leyclara.db",
    "jsonl": "corpus/articulos.jsonl"
  },

  "boe": {
    "base": "https://www.boe.es/datosabiertos/api/legislacion-consolidada",
    "user_agent": "LeyClara/0.1 (reutilizacion legislacion consolidada; contacto: Ntizar)",
    "reintentos": 3,
    "timeout_s": 120,
    "pausa_ms": 400
  },

  "recuperacion": {
    "solo_preceptos": true,
    "top_k": 50,
    "rerank": true,
    "modo": "hibrido",
    "solo_vigentes": false,
    "min_cobertura": 0.7,
    "min_terminos": 2,
    "min_similitud": 0.5,
    "min_caracteres_articulo": 15,
    "rrf_k": 60
  },

  "vectorial": {
    "endpoint": "https://api.nan.builders/v1/embeddings",
    "modelo": "qwen3-embedding",
    "lote": 32,
    "max_caracteres": 1200,
    "api_key_env": "HERMES_CUSTOM_OPENAI_COMPATIBLE_API_KEY"
  },

  "respuesta": {
    "modo": "extractivo",
    "max_citas": 6,
    "max_caracteres_cita": 600
  },

  "llm": {
    "habilitado": true,
    "endpoint": "https://api.nan.builders/v1/chat/completions",
    "modelo": "qwen3.6",
    "temperatura": 0,
    "max_tokens": 12000,
    "api_key_env": "HERMES_CUSTOM_OPENAI_COMPATIBLE_API_KEY"
  },

  "informe": {
    "dir": "informes",
    "incluir_enlace_oficial": true
  },

